NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://mirra:mirra_dev@localhost:3306/mirra
CLIENT_ORIGIN=http://localhost:5173

# Generate real values with:  npm run gen:keys
# Each must be 64 hex characters (32 random bytes). Never reuse one key for two purposes.
JWT_ACCESS_SECRET=
PHONE_ENC_KEY=
PHONE_HASH_KEY=
OTP_HASH_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# "console" prints codes to the server log (development only).
# Production refuses to start with "console": wire an email + SMS provider in src/lib/otp-delivery.js.
OTP_DELIVERY=console

# Optional, local testing only (refused in production): 1 turns every rate limit off.
# DISABLE_RATE_LIMITS=0
